{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hselith-mva.example/schemas/track2/candidate_drug.schema.json",
  "title": "CandidateDrug",
  "description": "An approved drug as a follow-up hypothesis (not a treatment recommendation).",
  "type": "object",
  "required": [
    "drug_id",
    "name",
    "approval",
    "targets",
    "mechanism_scores",
    "combined_score",
    "risk_flags",
    "direction_review",
    "age_profile",
    "gates",
    "evidence_for",
    "evidence_against",
    "toxicity",
    "excipients"
  ],
  "properties": {
    "drug_id": {
      "type": "string",
      "pattern": "^CHEMBL[0-9]+$"
    },
    "name": {
      "type": [
        "string",
        "null"
      ]
    },
    "approval": {
      "type": "object",
      "required": [
        "source",
        "chembl_version",
        "max_phase"
      ],
      "properties": {
        "source": {
          "const": "ChEMBL"
        },
        "chembl_version": {
          "type": "string"
        },
        "max_phase": {
          "const": 4
        },
        "first_approval": {
          "type": [
            "integer",
            "null"
          ]
        },
        "atc": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "label": {
          "type": "object"
        }
      }
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mechanism_scores": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "mechanism_id",
          "z",
          "rank",
          "passes_primary_threshold"
        ],
        "properties": {
          "mechanism_id": {
            "type": "string"
          },
          "z": {
            "type": "number"
          },
          "d": {
            "type": "number"
          },
          "p_empirical": {
            "type": "number"
          },
          "rank": {
            "type": "integer",
            "minimum": 1
          },
          "passes_primary_threshold": {
            "type": "boolean"
          }
        }
      }
    },
    "combined_score": {
      "type": "number",
      "minimum": 0
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risk_flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "direction_review": {
      "const": "REQUIRES_REVIEW"
    },
    "age_profile": {
      "type": "object",
      "required": [
        "adult",
        "neonate",
        "infant",
        "child",
        "adolescent"
      ],
      "properties": {
        "adult": {
          "type": "string"
        },
        "neonate": {
          "type": "string"
        },
        "infant": {
          "type": "string"
        },
        "child": {
          "type": "string"
        },
        "adolescent": {
          "type": "string"
        },
        "pediatric_label_status": {
          "type": "string"
        },
        "pediatric_excerpt": {
          "type": "string"
        },
        "heuristic": {
          "type": "boolean"
        }
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "requirement",
          "status"
        ],
        "properties": {
          "requirement": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT_ASSESSABLE"
            ]
          }
        }
      }
    },
    "evidence_for": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "id",
          "citation_verified"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "citation_verified": {
            "type": "boolean"
          }
        }
      }
    },
    "evidence_against": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "text"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "toxicity": {
      "type": "object",
      "required": [
        "available",
        "source"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "source": {
          "type": "string"
        },
        "total_reports": {
          "type": "integer"
        },
        "group_shares_of_top_terms": {
          "type": "object"
        },
        "caveat": {
          "type": "string"
        }
      }
    },
    "excipients": {
      "type": "object",
      "required": [
        "inactive_ingredients",
        "alerts"
      ],
      "properties": {
        "inactive_ingredients": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "alerts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "excipient",
              "concern"
            ]
          }
        }
      }
    }
  }
}